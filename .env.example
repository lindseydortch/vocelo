# Copy to .env.local and fill in real values. Never commit .env.local.
# Variable docs: context/environments.md. Validated by src/server/env.ts.

APP_URL=https://localhost:3000
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Only for `npm run seed`; the Neon dev endpoint host. Never set in production.
SEED_ALLOWED_HOST=ep-example-pooler.us-east-2.aws.neon.tech
SESSION_SECRET=replace-with-random-string
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

BUFFER_CLIENT_ID=dummy-buffer-client-id
BUFFER_CLIENT_SECRET=dummy-buffer-client-secret
# Optional personal key; enables /__dev/login. Never set in production.
BUFFER_API_KEY=

STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_CREATOR_PRICE_ID=price_dummy

# browser | elevenlabs | fixture
TTS_PROVIDER=browser
# Required only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=dummy-elevenlabs-key
# anthropic | fixture
LLM_PROVIDER=anthropic
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=dummy-anthropic-key

# Set to 1 if a provider dies mid-demo
DEMO_FALLBACK=
# Set only by the Playwright webServer command. Never set in production.
E2E_AUTH=
